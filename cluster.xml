<LATTICES>
  
  <UNITCELL name="simple2d" dimension="2" vertices="1">
    <VERTEX/>
  </UNITCELL>
  
  <LATTICE name="Betts2D-1A superlattice" dimension="2">
    <BASIS>
      <VECTOR>1 0 </VECTOR>
      <VECTOR>0 1 </VECTOR>
    </BASIS>
    <RECIPROCALBASIS>
      <VECTOR>2*pi 0 </VECTOR>
      <VECTOR>0 2*pi </VECTOR>
    </RECIPROCALBASIS>
  </LATTICE>
  <LATTICEGRAPH name = "Betts2D-1A">
    <FINITELATTICE>
      <LATTICE ref="Betts2D-1A superlattice"/>
      <PARAMETER name="L" default="30"/>
      <EXTENT dimension="1" size="L"/>
      <EXTENT dimension="2" size="L"/>
      <BOUNDARY type="periodic"/>
    </FINITELATTICE>
    <UNITCELL ref="simple2d"/>
  </LATTICEGRAPH>
  
<LATTICE name="Betts2D-2A superlattice" dimension="2">
  <BASIS>
    <VECTOR>1 0 </VECTOR>
    <VECTOR>0 2 </VECTOR>
  </BASIS>
  <RECIPROCALBASIS>
    <VECTOR>4*pi/2 0*pi/2 </VECTOR>
    <VECTOR>0*pi/2 2*pi/2 </VECTOR>
  </RECIPROCALBASIS>
</LATTICE>  

