# Deprecated ALPS 2.x Makefile fragment, generated by CMake. Use it as
#
#   include $(ALPS_ROOT)/share/alps/include.mk
#   app: app.o
#   	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
#
# Paths are relative to this file, so a relocated installation keeps working.

ALPS_MK_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))
prefix := $(abspath $(ALPS_MK_DIR)/../..)
exec_prefix = $(prefix)
bindir = $(prefix)/@CMAKE_INSTALL_BINDIR@
libdir = $(prefix)/@CMAKE_INSTALL_LIBDIR@
includedir = $(prefix)/@CMAKE_INSTALL_INCLUDEDIR@
datadir = $(prefix)/@CMAKE_INSTALL_DATADIR@
INCLUDE_MK = $(ALPS_MK_DIR)/include.mk

AR = @CMAKE_AR@
RANLIB = @CMAKE_RANLIB@
CC = @CMAKE_C_COMPILER@
CXX = @CMAKE_CXX_COMPILER@
CXXFLAGS = @ALPS_MK_CXXFLAGS@

ALPS_CPPFLAGS = -I$(includedir) @ALPS_MK_CPPFLAGS@
ALPS_LDFLAGS = -L$(libdir) -Wl,-rpath,$(libdir) @ALPS_MK_RPATHS@
ALPS_LIBS = @ALPS_MK_ALPS_LIBS@ @ALPS_MK_LIBS@

CPPFLAGS = $(ALPS_CPPFLAGS)
LDFLAGS = $(ALPS_LDFLAGS)
LIBS = $(ALPS_LIBS)
LDLIBS = $(ALPS_LIBS)
