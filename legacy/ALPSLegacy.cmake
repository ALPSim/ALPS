#
# The single switch between the current SDK and its deprecated interfaces.
# Everything under legacy/ is wired in here and nowhere else; the rest of the
# build only carries inert hooks that do nothing when this directory is absent:
#   - include(legacy/ALPSLegacy.cmake OPTIONAL) in the top-level CMakeLists.txt
#   - include(ALPSLegacyConfig.cmake OPTIONAL) in cmake/ALPSConfig.cmake.in
#   - a __has_include check in <alps/ngs/params.hpp>
# Removing the legacy layer means deleting this directory. See README.md.
include_guard(GLOBAL)

option(ALPS_LEGACY_API "Build and install deprecated ALPS 2.x interfaces" ON)
if(NOT ALPS_LEGACY_API)
  message(STATUS "Deprecated ALPS 2.x interfaces are disabled")
  return()
endif()
message(STATUS "Deprecated ALPS 2.x interfaces are enabled (ALPS_LEGACY_API)")
set(_alps_legacy_dir "${CMAKE_CURRENT_LIST_DIR}")

# C++: deprecated headers at their historical include spellings, and the
# definitions behind them. Every SDK target links ALPS::configuration, so the
# whole build sees one declaration of alps::params.
target_include_directories(alps_configuration INTERFACE
  "$<BUILD_INTERFACE:${_alps_legacy_dir}/include>")
target_sources(alps PRIVATE "${_alps_legacy_dir}/src/params_path_constructor.cpp")
install(DIRECTORY "${_alps_legacy_dir}/include/"
  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  COMPONENT headers)

# CMake and Make: UseALPS.cmake, UsePyALPS.cmake and include.mk.
include("${_alps_legacy_dir}/cmake/ALPSLegacyInterfaces.cmake")
file(WRITE "${PROJECT_BINARY_DIR}/cmake/ALPSLegacyConfig.cmake"
  "# Generated by legacy/ALPSLegacy.cmake. Deprecated ALPS 2.x entry points;\n"
  "# they take effect only when included.\n"
  "set(ALPS_LEGACY_API ON)\n"
  "set(ALPS_USE_FILE \"\${CMAKE_CURRENT_LIST_DIR}/UseALPS.cmake\")\n"
  "set(ALPS_PYTHON_USE_FILE \"\${CMAKE_CURRENT_LIST_DIR}/UsePyALPS.cmake\")\n")
install(FILES "${PROJECT_BINARY_DIR}/cmake/ALPSLegacyConfig.cmake"
  DESTINATION ${CMAKE_INSTALL_DATADIR}/alps
  COMPONENT build)

if(ALPS_BUILD_TESTING)
  add_subdirectory("${_alps_legacy_dir}/tests" legacy/tests)
endif()
