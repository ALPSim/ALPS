include(FindPackageHandleStandardArgs)

SET(INCLUDE_SEARCH_PATHS
 $ENV{GFTOOLS_DIR}/gf/include/
 ${GFTOOLS_DIR}/gf/include/
 )
SET(LIBRARY_SEARCH_PATHS
 $ENV{GFTOOLS_DIR}
 ${GFTOOLS_DIR}
 ${CMAKE_SOURCE_DIR}/GFTools/
 ${CMAKE_SOURCE_DIR}/../GFTools
 )


FIND_PATH(GFTOOLS_INCLUDE_DIR alps/gf/gf.hpp ${INCLUDE_SEARCH_PATHS} DOC "Green's function include path")
