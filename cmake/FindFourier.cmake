include(FindPackageHandleStandardArgs)

SET(INCLUDE_SEARCH_PATHS
 $ENV{LIBFOURIER_DIR}
 ${LIBFOURIER_DIR}
 ${CMAKE_SOURCE_DIR}/libfourier
 ${CMAKE_SOURCE_DIR}/../libfourier
 )
SET(LIBRARY_SEARCH_PATHS
 $ENV{LIBFOURIER_DIR}
 ${LIBFOURIER_DIR}
 ${CMAKE_SOURCE_DIR}/libfourier
 ${CMAKE_SOURCE_DIR}/../libfourier
 )


FIND_PATH(FOURIER_INCLUDE_DIR fourier_transform.h ${INCLUDE_SEARCH_PATHS} DOC "Fourier transform include path")
FIND_LIBRARY(FOURIER_LIBRARIES fourier ${LIBRARY_SEARCH_PATHS} DOC "Fourier transform library path")

FIND_PACKAGE_HANDLE_STANDARD_ARGS(FOURIER DEFAULT_MSG FOURIER_INCLUDE_DIR FOURIER_LIBRARIES)
