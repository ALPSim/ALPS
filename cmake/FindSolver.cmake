include(FindPackageHandleStandardArgs)

SET(INCLUDE_SEARCH_PATHS
 $ENV{LIBSOLVER_DIR}
 ${LIBSOLVER_DIR}
 ${DMFT_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/../libsolver
 )
SET(LIBRARY_SEARCH_PATHS
 $ENV{LIBSOLVER_DIR}
 ${LIBSOLVER_DIR}
 ${DMFT_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/../libsolver
 )


FIND_PATH(SOLVER_INCLUDE_DIR solver.h ${INCLUDE_SEARCH_PATHS} DOC "Solver transform include path")
FIND_LIBRARY(SOLVER_LIBRARIES solver ${LIBRARY_SEARCH_PATHS} DOC "Solver transform library path")

FIND_PACKAGE_HANDLE_STANDARD_ARGS(SOLVER DEFAULT_MSG SOLVER_INCLUDE_DIR SOLVER_LIBRARIES)
