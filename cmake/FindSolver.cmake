include(FindPackageHandleStandardArgs)

SET(INCLUDE_SEARCH_PATHS
 $ENV{LIBSOLVER_DIR}
 ${LIBSOLVER_DIR}
 ${DMFT_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/../libsolver
 )
SET(LIBRARY_SEARCH_PATHS
 $ENV{LIBSOLVER_DIR}
 ${LIBSOLVER_DIR}
 ${DMFT_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/libsolver
 ${CMAKE_SOURCE_DIR}/../libsolver
 )


FIND_PATH(SOLVER_INCLUDE_DIR solver.h PATHS ${INCLUDE_SEARCH_PATHS} DOC "Solver include path")
FIND_LIBRARY(SOLVER_LIBRARIES solver PATHS ${LIBRARY_SEARCH_PATHS} DOC "Solver library path")

FIND_PACKAGE_HANDLE_STANDARD_ARGS(Solver DEFAULT_MSG SOLVER_INCLUDE_DIR SOLVER_LIBRARIES)
