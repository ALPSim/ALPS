include(FindPackageHandleStandardArgs)

SET(INCLUDE_SEARCH_PATHS
 $ENV{LIBGREENS_DIR}
 ${LIBGREENS_DIR}
 ${CMAKE_SOURCE_DIR}/libgreens
 ${CMAKE_SOURCE_DIR}/../libgreens
 )
SET(LIBRARY_SEARCH_PATHS
 $ENV{LIBGREENS_DIR}
 ${LIBGREENS_DIR}
 ${CMAKE_SOURCE_DIR}/libgreens
 ${CMAKE_SOURCE_DIR}/../libgreens
 )


FIND_PATH(GREENS_INCLUDE_DIR green_function.h ${INCLUDE_SEARCH_PATHS} DOC "Green's function include path")
FIND_LIBRARY(GREENS_LIBRARIES green ${LIBRARY_SEARCH_PATHS} DOC "Green's function library path")

FIND_PACKAGE_HANDLE_STANDARD_ARGS(GREENS DEFAULT_MSG GREENS_INCLUDE_DIR GREENS_LIBRARIES)
