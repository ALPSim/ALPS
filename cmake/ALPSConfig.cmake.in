@PACKAGE_INIT@
# block() and the exported $<COMPILE_ONLY:...> interfaces need CMake 3.27.
# Fail with a clear message instead of "Unknown CMake command block".
if(CMAKE_VERSION VERSION_LESS 3.27)
  set(ALPS_FOUND FALSE)
  set(ALPS_NOT_FOUND_MESSAGE "ALPS requires CMake 3.27 or newer (found ${CMAKE_VERSION})")
  return()
endif()
include(CMakeFindDependencyMacro)
if(DEFINED BLA_SIZEOF_INTEGER AND NOT BLA_SIZEOF_INTEGER STREQUAL "4")
  set(ALPS_FOUND FALSE)
  set(ALPS_NOT_FOUND_MESSAGE "This ALPS SDK requires BLA_SIZEOF_INTEGER=4")
  return()
endif()
# Keep dependency preferences local; preserve find_dependency failure diagnostics.
block(SCOPE_FOR VARIABLES PROPAGATE ALPS_FOUND ALPS_NOT_FOUND_MESSAGE)
  find_dependency(Threads)
  find_dependency(Boost 1.76 CONFIG COMPONENTS @ALPS_BOOST_COMPONENTS@)
  set(HDF5_USE_STATIC_LIBRARIES "@HDF5_USE_STATIC_LIBRARIES@")
  find_dependency(HDF5 @ALPS_HDF5_MIN_VERSION@ MODULE COMPONENTS C)
  if(@ALPS_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
  endif()
  if(@ALPS_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
  endif()
  set(BLA_SIZEOF_INTEGER 4)
  set(BLA_VENDOR "@ALPS_BLA_VENDOR@")
  set(BLA_STATIC "@ALPS_BLA_STATIC@")
  find_dependency(@ALPS_BLAS_DEPENDENCY@)
  find_dependency(@ALPS_LAPACK_DEPENDENCY@)
endblock()
include("${CMAKE_CURRENT_LIST_DIR}/ALPSTargets.cmake")

set(ALPS_VERSION "@ALPS_VERSION@")
set(ALPS_BIN_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(ALPS_RUNTIME_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(ALPS_RUNTIME_TARGETS "@ALPS_SDK_RUNTIME_TARGETS@")
set(ALPS_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/alps")
set(ALPS_MPI_ENABLED "@ALPS_ENABLE_MPI@")
# Deprecated ALPS 2.x entry points; they take effect only when included.
set(ALPS_USE_FILE "${CMAKE_CURRENT_LIST_DIR}/UseALPS.cmake")
set(ALPS_PYTHON_USE_FILE "${CMAKE_CURRENT_LIST_DIR}/UsePyALPS.cmake")
# Deprecated C++ interfaces, present only when the SDK was built with the legacy layer.
include("${CMAKE_CURRENT_LIST_DIR}/ALPSLegacyConfig.cmake" OPTIONAL)
# Generated from ALPS_SDK_TARGETS in src/alps/CMakeLists.txt.
foreach(component IN ITEMS @ALPS_SDK_COMPONENTS@)
  set(ALPS_${component}_FOUND TRUE)
endforeach()
set(ALPS_solvers_FOUND "@ALPS_BUILD_APPLICATIONS@")
set(ALPS_applications_FOUND FALSE)
if("applications" IN_LIST ALPS_FIND_COMPONENTS AND @ALPS_BUILD_APPLICATIONS@
    AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/ALPSApplicationTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/ALPSApplicationTargets.cmake")
  set(ALPS_APPLICATION_TARGETS "@ALPS_APPLICATION_TARGETS@")
  set(ALPS_applications_FOUND TRUE)
endif()
# Components that need Eigen are built only when it was found, and each has its
# own export, so only their consumers need Eigen. See src/alps/CMakeLists.txt.
set(_alps_eigen_built "@ALPS_EIGEN_COMPONENTS@")
foreach(_alps_component IN ITEMS @ALPS_EIGEN_COMPONENT_NAMES@)
  set(ALPS_${_alps_component}_FOUND FALSE)
  if(NOT _alps_component IN_LIST ALPS_FIND_COMPONENTS)
    continue()
  endif()
  string(SUBSTRING "${_alps_component}" 0 1 _alps_initial)
  string(TOUPPER "${_alps_initial}" _alps_initial)
  string(SUBSTRING "${_alps_component}" 1 -1 _alps_rest)
  set(_alps_export "${CMAKE_CURRENT_LIST_DIR}/ALPS${_alps_initial}${_alps_rest}Targets.cmake")
  if(NOT _alps_component IN_LIST _alps_eigen_built OR NOT EXISTS "${_alps_export}")
    set(_alps_missing "this SDK was built without it, because Eigen was not found")
  else()
    # As in src/alps: neither a minimum nor a range suits Eigen 3 and 5 alike.
    if(NOT Eigen3_FOUND)
      find_package(Eigen3 CONFIG QUIET)
    endif()
    if(Eigen3_FOUND AND NOT Eigen3_VERSION VERSION_LESS 3.3)
      include("${_alps_export}")
      set(ALPS_${_alps_component}_FOUND TRUE)
    else()
      set(_alps_missing "it requires Eigen 3.3 or newer, which was not found")
    endif()
  endif()
  if(NOT ALPS_${_alps_component}_FOUND AND ALPS_FIND_REQUIRED_${_alps_component})
    set(ALPS_NOT_FOUND_MESSAGE "ALPS component ${_alps_component} is unavailable: ${_alps_missing}")
  endif()
endforeach()
unset(_alps_eigen_built)
unset(_alps_component)
unset(_alps_initial)
unset(_alps_rest)
unset(_alps_export)
unset(_alps_missing)
check_required_components(ALPS)
