@PACKAGE_INIT@
set(_ALPS_PACKAGE_PREFIX "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
if(DEFINED BLA_SIZEOF_INTEGER AND NOT BLA_SIZEOF_INTEGER EQUAL @BLA_SIZEOF_INTEGER@)
  set(ALPS_FOUND FALSE)
  set(ALPS_NOT_FOUND_MESSAGE "This ALPS SDK requires BLA_SIZEOF_INTEGER=@BLA_SIZEOF_INTEGER@")
  return()
endif()
# Functions scope finder inputs without hiding the imported targets. A failed
# find_dependency returns from this function; the caller then rejects the SDK.
function(_alps_find_dependencies)
  set(ALPS_FOUND FALSE PARENT_SCOPE)
  set(ALPS_NOT_FOUND_MESSAGE "An ALPS SDK dependency could not be found" PARENT_SCOPE)
  find_dependency(Threads)
  find_dependency(Boost 1.76 CONFIG COMPONENTS @ALPS_BOOST_COMPONENTS@)
  set(HDF5_USE_STATIC_LIBRARIES "@HDF5_USE_STATIC_LIBRARIES@")
  find_dependency(HDF5 COMPONENTS C)
  if(@ALPS_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
  endif()
  if(@ALPS_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
  endif()
  set(BLA_SIZEOF_INTEGER @BLA_SIZEOF_INTEGER@)
  set(BLA_VENDOR "@ALPS_BLA_VENDOR@")
  set(BLA_STATIC "@ALPS_BLA_STATIC@")
  if("@ALPS_BLAS_PROVIDER@" STREQUAL "OpenBLAS")
    find_dependency(OpenBLAS CONFIG)
  elseif("@ALPS_BLAS_PROVIDER@" STREQUAL "BLAS")
    find_dependency(BLAS)
  endif()
  if("@ALPS_LAPACK_PROVIDER@" STREQUAL "lapack")
    find_dependency(lapack CONFIG NAMES lapack)
  else()
    find_dependency(LAPACK)
  endif()
  set(ALPS_FOUND TRUE PARENT_SCOPE)
  unset(ALPS_NOT_FOUND_MESSAGE PARENT_SCOPE)
endfunction()
_alps_find_dependencies()
if(NOT ALPS_FOUND)
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ALPSTargets.cmake")
set(PACKAGE_PREFIX_DIR "${_ALPS_PACKAGE_PREFIX}")

set(ALPS_VERSION "@ALPS_VERSION@")
set(ALPS_VERSION_CORE "@ALPS_VERSION_CORE@")
set(ALPS_VERSION_MAJOR "@ALPS_VERSION_MAJOR@")
set(ALPS_VERSION_MINOR "@ALPS_VERSION_MINOR@")
set(ALPS_VERSION_PATCH "@ALPS_VERSION_PATCH@")
set(ALPS_VERSION_PRERELEASE "@ALPS_VERSION_PRERELEASE@")
set(ALPS_RUNTIME_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(ALPS_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/alps")
include("${CMAKE_CURRENT_LIST_DIR}/ALPSPython.cmake")
set(ALPS_MPI_ENABLED "@ALPS_ENABLE_MPI@")
set(ALPS_HDF5_TARGETS @ALPS_HDF5_TARGETS@)
set(ALPS_alps_FOUND TRUE)
set(ALPS_headers_FOUND TRUE)
set(ALPS_fortran_FOUND "@ALPS_BUILD_FORTRAN@")
set(ALPS_applications_FOUND FALSE)
if("applications" IN_LIST ALPS_FIND_COMPONENTS AND @ALPS_BUILD_APPLICATIONS@
    AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/ALPSApplicationTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/ALPSApplicationTargets.cmake")
  set(ALPS_APPLICATION_TARGETS "@ALPS_APPLICATION_TARGETS@")
  set(ALPS_applications_FOUND TRUE)
endif()
check_required_components(ALPS)
