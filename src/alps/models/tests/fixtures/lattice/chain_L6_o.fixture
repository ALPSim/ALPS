case chain_L6_o
dimension 1
extent 6
boundary open
alps_name open chain lattice
num_sites 6
num_bonds 5
site 0 0 0 0
site 1 0 0 1
site 2 0 0 2
site 3 0 0 3
site 4 0 0 4
site 5 0 0 5
bond 0 1 0 0 1
bond 1 2 0 0 1
bond 2 3 0 0 1
bond 3 4 0 0 1
bond 4 5 0 0 1
param L 6
param LATTICE open chain lattice
param bc1 open
momentum 
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 1
basis = [["1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 1
vertex = [
  { type = 0, coordinate = ["0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["6"], boundary = ["open"] }
unitcell = "alps_custom_lattice cell"
toml-end
