toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 3
basis = [["0.5", "0.5", "0"], ["0.5", "0", "0.5"], ["0", "0.5", "0.5"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 3
vertex = [
  { type = 0, coordinate = ["0", "0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [1, 0, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [0, 1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [0, 0, 1] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [1, -1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [1, 0, -1] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [0, 1, -1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["2", "2", "2"], boundary = ["periodic", "periodic", "periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
