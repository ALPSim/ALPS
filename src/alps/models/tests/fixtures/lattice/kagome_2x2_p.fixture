  { type = 0, coordinate = ["0", "0"] },
  { type = 1, coordinate = ["0.5", "0"] },
  { type = 2, coordinate = ["0", "0.5"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 2, offset = [0, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 3, offset = [0, 0] } },
  { type = 0, source = { vertex = 2, offset = [0, 0] }, target = { vertex = 3, offset = [0, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 2, offset = [-1, 0] } },
  { type = 0, source = { vertex = 2, offset = [0, 0] }, target = { vertex = 3, offset = [1, -1] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 3, offset = [0, -1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["2", "2"], boundary = ["periodic", "periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
