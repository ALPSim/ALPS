case frustrated_square_3x3_p
dimension 2
extent 3 3
boundary periodic periodic
alps_name frustrated square lattice
num_sites 9
num_bonds 36
site 0 0 0 0 0
site 1 0 0 0 1
site 2 0 0 0 2
site 3 0 0 1 0
site 4 0 0 1 1
site 5 0 0 1 2
site 6 0 0 2 0
site 7 0 0 2 1
site 8 0 0 2 2
bond 0 3 0 0 1 0
bond 0 1 0 0 0 1
bond 0 4 1 0 1 1
bond 0 5 1 1 1 2
bond 1 4 0 0 1 0
bond 1 2 0 0 0 1
bond 1 5 1 0 1 1
bond 1 3 1 0 1 -1
bond 2 5 0 0 1 0
bond 2 0 0 1 0 -2
bond 2 3 1 1 1 -2
bond 2 4 1 0 1 -1
bond 3 6 0 0 1 0
bond 3 4 0 0 0 1
bond 3 7 1 0 1 1
bond 3 8 1 1 1 2
bond 4 7 0 0 1 0
bond 4 5 0 0 0 1
bond 4 8 1 0 1 1
bond 4 6 1 0 1 -1
bond 5 8 0 0 1 0
bond 5 3 0 1 0 -2
bond 5 6 1 1 1 -2
bond 5 7 1 0 1 -1
bond 6 0 0 1 -2 0
bond 6 7 0 0 0 1
bond 6 1 1 1 -2 1
bond 6 2 1 1 -2 2
bond 7 1 0 1 -2 0
bond 7 8 0 0 0 1
bond 7 2 1 1 -2 1
bond 7 0 1 1 -2 -1
bond 8 2 0 1 -2 0
bond 8 6 0 1 0 -2
bond 8 0 1 1 -2 -2
bond 8 1 1 1 -2 -1
param L 3
param LATTICE frustrated square lattice
param W 3
param bc1 periodic
param bc2 periodic
momentum 0 0
momentum 0 2.0943951023931953
momentum 0 4.1887902047863905
momentum 2.0943951023931953 0
momentum 2.0943951023931953 2.0943951023931953
momentum 2.0943951023931953 4.1887902047863905
momentum 4.1887902047863905 0
momentum 4.1887902047863905 2.0943951023931953
momentum 4.1887902047863905 4.1887902047863905
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 2
basis = [["1", "0"], ["0", "1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 2
vertex = [
  { type = 0, coordinate = ["0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [0, 1] } },
  { type = 1, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, 1] } },
  { type = 1, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, -1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["3", "3"], boundary = ["periodic", "periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
