case nnn_chain_L5_o
dimension 1
extent 5
boundary open
alps_name nnn open chain lattice
num_sites 5
num_bonds 7
site 0 0 0 0
site 1 0 0 1
site 2 0 0 2
site 3 0 0 3
site 4 0 0 4
bond 0 1 0 0 1
bond 0 2 1 0 2
bond 1 2 0 0 1
bond 1 3 1 0 2
bond 2 3 0 0 1
bond 2 4 1 0 2
bond 3 4 0 0 1
param LATTICE alps_custom_lattice_509145c350c9778a
momentum 
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 1
basis = [["1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 1
vertex = [
  { type = 0, coordinate = ["0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [1] } },
  { type = 1, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [2] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["5"], boundary = ["open"] }
unitcell = "alps_custom_lattice cell"
toml-end
