case simple_cubic_2x2x2_o
dimension 3
extent 2 2 2
boundary open open open
alps_name simple cubic lattice
num_sites 8
num_bonds 12
site 0 0 0 0 0 0
site 1 0 0 0 0 1
site 2 0 0 0 1 0
site 3 0 0 0 1 1
site 4 0 0 1 0 0
site 5 0 0 1 0 1
site 6 0 0 1 1 0
site 7 0 0 1 1 1
bond 0 4 0 0 1 0 0
bond 0 2 0 0 0 1 0
bond 0 1 0 0 0 0 1
bond 1 5 0 0 1 0 0
bond 1 3 0 0 0 1 0
bond 2 6 0 0 1 0 0
bond 2 3 0 0 0 0 1
bond 3 7 0 0 1 0 0
bond 4 6 0 0 0 1 0
bond 4 5 0 0 0 0 1
bond 5 7 0 0 0 1 0
bond 6 7 0 0 0 0 1
param H 2
param L 2
param LATTICE open simple cubic lattice
param W 2
param bc1 open
param bc2 open
param bc3 open
momentum 
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 3
basis = [["1", "0", "0"], ["0", "1", "0"], ["0", "0", "1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 3
vertex = [
  { type = 0, coordinate = ["0", "0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [1, 0, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [0, 1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0, 0] }, target = { vertex = 1, offset = [0, 0, 1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["2", "2", "2"], boundary = ["open", "open", "open"] }
unitcell = "alps_custom_lattice cell"
toml-end
