case rectangular_3x2_b05_p
dimension 2
extent 3 2
boundary periodic periodic
alps_name rectangular lattice
num_sites 6
num_bonds 12
site 0 0 0 0 0
site 1 0 0 0 0.5
site 2 0 0 1 0
site 3 0 0 1 0.5
site 4 0 0 2 0
site 5 0 0 2 0.5
bond 0 2 0 0 1 0
bond 0 1 0 0 0 0.5
bond 1 3 0 0 1 0
bond 1 0 0 1 0 -0.5
bond 2 4 0 0 1 0
bond 2 3 0 0 0 0.5
bond 3 5 0 0 1 0
bond 3 2 0 1 0 -0.5
bond 4 0 0 1 -2 0
bond 4 5 0 0 0 0.5
bond 5 1 0 1 -2 0
bond 5 4 0 1 0 -0.5
param L 3
param LATTICE rectangular lattice
param W 2
param bc1 periodic
param bc2 periodic
momentum 0 0
momentum 0 3.1415926535897931
momentum 2.0943951023931953 0
momentum 2.0943951023931953 3.1415926535897931
momentum 4.1887902047863905 0
momentum 4.1887902047863905 3.1415926535897931
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 2
basis = [["1", "0"], ["0", "0.5"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 2
vertex = [
  { type = 0, coordinate = ["0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [0, 1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["3", "2"], boundary = ["periodic", "periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
