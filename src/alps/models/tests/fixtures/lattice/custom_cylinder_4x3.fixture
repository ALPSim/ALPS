case custom_cylinder_4x3
dimension 2
extent 4 3
boundary periodic open
alps_name -
num_sites 12
num_bonds 20
site 0 0 0 0 0
site 1 0 0 0 1
site 2 0 0 0 2
site 3 0 0 1 0
site 4 0 0 1 1
site 5 0 0 1 2
site 6 0 0 2 0
site 7 0 0 2 1
site 8 0 0 2 2
site 9 0 0 3 0
site 10 0 0 3 1
site 11 0 0 3 2
bond 0 3 0 0 1 0
bond 0 1 0 0 0 1
bond 1 4 0 0 1 0
bond 1 2 0 0 0 1
bond 2 5 0 0 1 0
bond 3 6 0 0 1 0
bond 3 4 0 0 0 1
bond 4 7 0 0 1 0
bond 4 5 0 0 0 1
bond 5 8 0 0 1 0
bond 6 9 0 0 1 0
bond 6 7 0 0 0 1
bond 7 10 0 0 1 0
bond 7 8 0 0 0 1
bond 8 11 0 0 1 0
bond 9 0 0 1 -3 0
bond 9 10 0 0 0 1
bond 10 1 0 1 -3 0
bond 10 11 0 0 0 1
bond 11 2 0 1 -3 0
param LATTICE alps_custom_lattice_9a1cbdd10160311c
momentum 0
momentum 1.5707963267948966
momentum 3.1415926535897931
momentum 4.7123889803846897
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 2
basis = [["1", "0"], ["0", "1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 2
vertex = [
  { type = 0, coordinate = ["0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [0, 1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["4", "3"], boundary = ["periodic", "open"] }
unitcell = "alps_custom_lattice cell"
toml-end
