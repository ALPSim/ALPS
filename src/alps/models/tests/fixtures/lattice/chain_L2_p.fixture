case chain_L2_p
dimension 1
extent 2
boundary periodic
alps_name chain lattice
num_sites 2
num_bonds 2
site 0 0 0 0
site 1 0 0 1
bond 0 1 0 0 1
bond 1 0 0 1 -1
param L 2
param LATTICE chain lattice
param bc1 periodic
momentum 0
momentum 3.1415926535897931
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 1
basis = [["1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 1
vertex = [
  { type = 0, coordinate = ["0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["2"], boundary = ["periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
