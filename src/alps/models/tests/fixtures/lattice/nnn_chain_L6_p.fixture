case nnn_chain_L6_p
dimension 1
extent 6
boundary periodic
alps_name nnn chain lattice
num_sites 6
num_bonds 12
site 0 0 0 0
site 1 0 0 1
site 2 0 0 2
site 3 0 0 3
site 4 0 0 4
site 5 0 0 5
bond 0 1 0 0 1
bond 0 2 1 0 2
bond 1 2 0 0 1
bond 1 3 1 0 2
bond 2 3 0 0 1
bond 2 4 1 0 2
bond 3 4 0 0 1
bond 3 5 1 0 2
bond 4 5 0 0 1
bond 4 0 1 1 -4
bond 5 0 0 1 -5
bond 5 1 1 1 -4
param L 6
param LATTICE nnn chain lattice
param bc1 periodic
momentum 0
momentum 1.0471975511965976
momentum 2.0943951023931953
momentum 3.1415926535897931
momentum 4.1887902047863905
momentum 5.2359877559829888
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 1
basis = [["1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 1
vertex = [
  { type = 0, coordinate = ["0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [1] } },
  { type = 1, source = { vertex = 1, offset = [0] }, target = { vertex = 1, offset = [2] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["6"], boundary = ["periodic"] }
unitcell = "alps_custom_lattice cell"
toml-end
