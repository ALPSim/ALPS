case square_3x4_o
dimension 2
extent 3 4
boundary open open
alps_name square lattice
num_sites 12
num_bonds 17
site 0 0 0 0 0
site 1 0 0 0 1
site 2 0 0 0 2
site 3 0 0 0 3
site 4 0 0 1 0
site 5 0 0 1 1
site 6 0 0 1 2
site 7 0 0 1 3
site 8 0 0 2 0
site 9 0 0 2 1
site 10 0 0 2 2
site 11 0 0 2 3
bond 0 4 0 0 1 0
bond 0 1 0 0 0 1
bond 1 5 0 0 1 0
bond 1 2 0 0 0 1
bond 2 6 0 0 1 0
bond 2 3 0 0 0 1
bond 3 7 0 0 1 0
bond 4 8 0 0 1 0
bond 4 5 0 0 0 1
bond 5 9 0 0 1 0
bond 5 6 0 0 0 1
bond 6 10 0 0 1 0
bond 6 7 0 0 0 1
bond 7 11 0 0 1 0
bond 8 9 0 0 0 1
bond 9 10 0 0 0 1
bond 10 11 0 0 0 1
param L 3
param LATTICE open square lattice
param W 4
param bc1 open
param bc2 open
momentum 
toml-begin
[[lattice]]
name = "alps_custom_lattice base"
dimension = 2
basis = [["1", "0"], ["0", "1"]]

[[unitcell]]
name = "alps_custom_lattice cell"
dimension = 2
vertex = [
  { type = 0, coordinate = ["0", "0"] },
]
edge = [
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [1, 0] } },
  { type = 0, source = { vertex = 1, offset = [0, 0] }, target = { vertex = 1, offset = [0, 1] } },
]

[[latticegraph]]
name = "alps_custom_lattice"
finitelattice = { lattice = "alps_custom_lattice base", extent = ["3", "4"], boundary = ["open", "open"] }
unitcell = "alps_custom_lattice cell"
toml-end
