<LATTICES>
  <GRAPH name="2x2 plaquette" vertices="4">
    <!--  3 ---- 4
          |      |
          1 ---- 2      (ALPS numbers sites 0..3 internally) -->
    <EDGE source="1" target="2"/>
    <EDGE source="3" target="4"/>
    <EDGE source="1" target="3"/>
    <EDGE source="2" target="4"/>
    <!-- new: an ordered group of sites; the order fixes the roles i j k l -->
    <NSITE type="0">
      <SITE id="1"/><SITE id="2"/><SITE id="4"/><SITE id="3"/>
    </NSITE>
  </GRAPH>
</LATTICES>
