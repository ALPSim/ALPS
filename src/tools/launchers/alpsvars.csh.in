setenv ALPS_HOME @CMAKE_INSTALL_PREFIX@
setenv ALPS_ROOT @CMAKE_INSTALL_PREFIX@

if !($?PATH) then
    setenv PATH ${ALPS_HOME}/@CMAKE_INSTALL_BINDIR@
else
    setenv PATH ${ALPS_HOME}/@CMAKE_INSTALL_BINDIR@:${PATH}
endif

if !($?LD_LIBRARY_PATH) then
    setenv LD_LIBRARY_PATH ${ALPS_HOME}/@CMAKE_INSTALL_LIBDIR@
else
    setenv LD_LIBRARY_PATH ${ALPS_HOME}/@CMAKE_INSTALL_LIBDIR@:${LD_LIBRARY_PATH}
endif

if !($?PYTHONPATH) then
    setenv PYTHONPATH ${ALPS_HOME}/@CMAKE_INSTALL_LIBDIR@
else
    setenv PYTHONPATH ${ALPS_HOME}/@CMAKE_INSTALL_LIBDIR@:${PYTHONPATH}
endif
