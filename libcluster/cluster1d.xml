<LATTICES>
  <!--basic 1d unit cell element -->
  <UNITCELL name="simple1d" dimension="1" vertices="1">
    <VERTEX/>
  </UNITCELL>
  
  <!-- 1d 1-site cluster and superlattice -->
  <LATTICE name="Chain1D_1 superlattice" dimension="1">
    <BASIS>
      <VECTOR>1 </VECTOR>
    </BASIS>
    <RECIPROCALBASIS>
      <VECTOR>2*pi </VECTOR>
    </RECIPROCALBASIS>
  </LATTICE>
  <LATTICEGRAPH name = "Chain1D_1">
    <FINITELATTICE>
      <LATTICE ref="Chain1D_1 superlattice"/>
      <PARAMETER name="L" default="30"/>
      <EXTENT dimension="1" size="L"/>
      <BOUNDARY type="periodic"/>
    </FINITELATTICE>
    <UNITCELL ref="simple1d"/>
  </LATTICEGRAPH>
  
  
  
