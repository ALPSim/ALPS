<LATTICES>

  <UNITCELL name="twovertex t-tprime-tperp" dimension="2" vertices="2">
    <VERTEX type="1"/>
    <VERTEX type="2"/>
    <EDGE type="0"><SOURCE vertex="1" offset="0 0"/><TARGET vertex="1" offset="0 1"/></EDGE>
    <EDGE type="0"><SOURCE vertex="2" offset="0 0"/><TARGET vertex="2" offset="0 1"/></EDGE>
    <EDGE type="1"><SOURCE vertex="1" offset="0 0"/><TARGET vertex="2" offset="0 0"/></EDGE>
    <EDGE type="2"><SOURCE vertex="2" offset="0 0"/><TARGET vertex="1" offset="1 0"/></EDGE>
  </UNITCELL>

  <LATTICE name="ladder superlattice" dimension="2">
    <BASIS>
      <VECTOR>L 0 </VECTOR>
      <VECTOR>0 2 </VECTOR>
    </BASIS>
    <RECIPROCALBASIS>
      <VECTOR>2*pi/L 0 </VECTOR>
      <VECTOR>0 2*pi/2 </VECTOR>
    </RECIPROCALBASIS>
  </LATTICE>

  <LATTICEGRAPH name = "ladder 8">
    <FINITELATTICE>
      <PARAMETER name="L" default="8"/>
      <PARAMETER name="LSUPER" default="10"/>
      <PARAMETER name="WSUPER" default="10"/>
      <LATTICE ref="ladder superlattice"/>
      <EXTENT dimension="1" size="LSUPER"/>
      <EXTENT dimension="2" size="WSUPER"/>
      <BOUNDARY type="periodic"/>
    </FINITELATTICE>
    <UNITCELL ref="twovertex t-tprime-tperp"/>
  </LATTICEGRAPH>
</LATTICE>
