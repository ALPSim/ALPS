# Generated from pyalps_config.py.in by python/pyalps/CMakeLists.txt.
#
# SDK executable directory for bindings-only builds; empty for bundled wheels.
# XML resources are always bundled and need no SDK fallback.
ALPS_BIN_INSTALL_DIR="@PYALPS_ALPS_BIN_FALLBACK@"

# nanobind that built these extensions. Downstream modules deriving from pyalps
# types must use the same internals ABI; the installed pyalps CMake package checks it.
NANOBIND_VERSION="@PYALPS_NANOBIND_VERSION@"
NANOBIND_INTERNALS_VERSION="@PYALPS_NANOBIND_INTERNALS_VERSION@"
