{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/_build/${presetName}/install"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/${presetName}"
    },
    {
      "name": "sdk",
      "displayName": "Library and installed C++ SDK",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_TESTING": "OFF",
        "ALPS_BUILD_APPLICATIONS": "OFF"
      }
    },
    {
      "name": "distribution",
      "displayName": "Redistributable SDK and applications",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "ON",
        "ALPS_BUILD_TESTING": "OFF"
      },
      "inherits": "default"
    },
    {
      "name": "dev",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mpi",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "ALPS_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "extensive",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "ALPS_BUILD_EXTENSIVE_TESTS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "ALPS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wheel-deps",
      "inherits": "distribution"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "sdk",
      "configurePreset": "sdk"
    },
    {
      "name": "distribution",
      "configurePreset": "distribution",
      "targets": [
        "install"
      ]
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "mpi",
      "configurePreset": "mpi"
    },
    {
      "name": "extensive",
      "configurePreset": "extensive"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "wheel-deps",
      "configurePreset": "wheel-deps",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mpi",
      "configurePreset": "mpi",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "extensive",
      "configurePreset": "extensive",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
