{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/_build/${presetName}/install",
        "ALPS_ENABLE_MPI": "OFF",
        "ALPS_ENABLE_OPENMP": "OFF"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/${presetName}"
    },
    {
      "name": "mpi",
      "displayName": "MPI release build",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_ENABLE_MPI": "ON",
        "ALPS_ENABLE_OPENMP": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "CMAKE_PROJECT_alps_INCLUDE": "${sourceDir}/tests/cmake/register_mpi_tests.cmake"
      }
    },
    {
      "name": "openmp",
      "displayName": "OpenMP release build",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_ENABLE_MPI": "OFF",
        "ALPS_ENABLE_OPENMP": "ON"
      }
    },
    {
      "name": "mpi-openmp",
      "displayName": "MPI and OpenMP release build",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_ENABLE_MPI": "ON",
        "ALPS_ENABLE_OPENMP": "ON"
      }
    },
    {
      "name": "sdk",
      "displayName": "Library and installed C++ SDK",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_TESTING": "OFF",
        "ALPS_BUILD_APPLICATIONS": "OFF"
      }
    },
    {
      "name": "distribution",
      "displayName": "Redistributable SDK and applications",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "ON",
        "ALPS_BUILD_TESTING": "OFF"
      },
      "inherits": "default"
    },
    {
      "name": "dev",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON"
      }
    },
    {
      "name": "extensive",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "ALPS_BUILD_EXTENSIVE_TESTS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "default",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "OFF",
        "ALPS_BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "sdk",
      "configurePreset": "sdk"
    },
    {
      "name": "distribution",
      "configurePreset": "distribution",
      "targets": [
        "install"
      ]
    },
    {
      "name": "mpi",
      "configurePreset": "mpi"
    },
    {
      "name": "openmp",
      "configurePreset": "openmp"
    },
    {
      "name": "mpi-openmp",
      "configurePreset": "mpi-openmp"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "extensive",
      "configurePreset": "extensive"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mpi",
      "inherits": "default",
      "configurePreset": "mpi"
    },
    {
      "name": "openmp",
      "inherits": "default",
      "configurePreset": "openmp"
    },
    {
      "name": "mpi-openmp",
      "inherits": "default",
      "configurePreset": "mpi-openmp"
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "extensive",
      "configurePreset": "extensive",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
