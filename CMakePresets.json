{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/_build/${presetName}/install"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/${presetName}"
    },
    {
      "name": "sdk",
      "displayName": "Library and installed C++ SDK",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "ALPS_BUILD_APPLICATIONS": "OFF"
      }
    },
    {
      "name": "distribution",
      "displayName": "Redistributable SDK and applications",
      "cacheVariables": {
        "ALPS_BUILD_APPLICATIONS": "ON",
        "BUILD_TESTING": "OFF"
      },
      "inherits": "default"
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 SDK and applications (MSVC/vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": null
      },
      "inherits": "default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Native Windows ARM64 SDK and applications (MSVC/vcpkg)",
      "inherits": "windows-x64",
      "architecture": "ARM64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-arm64-overlay"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "sdk",
      "configurePreset": "sdk"
    },
    {
      "name": "distribution",
      "configurePreset": "distribution",
      "targets": [
        "install"
      ]
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "inherits": "default"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release",
      "inherits": "default"
    }
  ]
}
